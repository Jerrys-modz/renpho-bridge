RENPHO_EMAIL=
RENPHO_PASSWORD=
# Two-letter area from the Renpho Health account (the app login region), not the shop website.
# renpho.eu accounts still use https://cloud.renpho.com. Examples: DE, GB, FR, NL, US.
RENPHO_AREA_CODE=US
# Optional override. Leave unset unless your account is on a different Renpho Health cloud.
#RENPHO_API_URL=https://cloud.renpho.com
SPARKY_URL=http://localhost:3010
SPARKY_API_KEY=
SYNC_INTERVAL_MINUTES=60
LENGTH_UNIT=cm
TEST_MODE=false
SYNC_DAYS=3
DEBUG=false
SYNC_DEVICES=scale,tape
#SCALE_TABLES=
# Optional monitoring: healthchecks.io-style ping URL (GET on success, POST <url>/fail on failure)
#HEALTHCHECK_URL=
# Optional alert URL, e.g. https://ntfy.sh/your-topic (POSTed once when a sync starts failing, once on recovery)
#NOTIFY_URL=
# Total tries per sync for temporary network/server errors
SYNC_RETRIES=3
