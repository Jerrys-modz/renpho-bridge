  "description": "Community tool that syncs RENPHO smart tape measure and scale measurements into SparkyFitness",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "sparkyfitness-renpho": "dist/cli.js" },
